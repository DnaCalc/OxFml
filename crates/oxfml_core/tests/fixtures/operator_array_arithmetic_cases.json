    "expected_value_summary": "Array(Number(9),Number(8),Number(7),Number(6))"
  },
  {
    "case_id": "arr_op_004_same_shape_array_add",
    "formula": "={1,2;3,4}+{10,20;30,40}",
    "expected_payload_summary": "Array(2x2)",
    "expected_value_summary": "Array(Number(11),Number(22),Number(33),Number(44))"
  },
  {
    "case_id": "arr_op_005_array_division_internal_error",
    "formula": "={8,6;4,2}/{2,0;1,2}",
